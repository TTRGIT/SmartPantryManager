<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pantry preferences"
        android:textColor="@color/charcoal"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/expiry_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/expiring_alerts"
        android:textColor="@color/charcoal"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="48dp"
        android:text="@string/expiring_alerts_summary"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/units_preference"
        android:textColor="@color/charcoal"
        android:textSize="17sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/unit_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/metric_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Metric (g, kg, ml, L)" />

        <RadioButton
            android:id="@+id/kitchen_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kitchen measures (tsp, tbsp, cups)" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_badge_green"
        android:padding="18dp"
        android:text="Smart Pantry Recipe matches are calculated privately from the ingredients stored on this device."
        android:textColor="@color/green_900"
        android:textSize="14sp" />
</LinearLayout>
